# Copie para .env.local (local) ou cadastre na Vercel (produção).

# Contentful
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT_ID=master
# Token da Content Delivery API (somente leitura)
CONTENTFUL_ACCESS_TOKEN=
# Personal Access Token (CFPAT-...) — necessário só para fazer o sorteio
CONTENTFUL_MANAGER_ACCESS_TOKEN=
# Opcionais
# CONTENTFUL_CONTENT_TYPE=people
# CONTENTFUL_LOCALE=en-US

# Senha da área do organizador (/draw)
ADMIN_PASSWORD=
# Chave secreta dos links. Gere com: openssl rand -base64 32
# Trocar essa chave invalida todos os links já enviados.
LINK_SECRET=
